{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client", "@shopify/polaris-types", "node"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@ljsstudios/index-filter-bar": ["./src/index.ts"]
    },
    "allowImportingTsExtensions": true
  },
  "include": ["src", "demo", "scripts", "vitest.config.ts", "vite.config.ts", "vite.demo.config.ts"]
}
