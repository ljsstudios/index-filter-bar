{
  "name": "@ljsstudios/index-filter-bar",
  "version": "0.1.1",
  "description": "The Shopify admin's index search and filter bar for embedded apps on Polaris 2.0 web components: every filter type, saved views, columns and sort.",
  "keywords": [
    "shopify",
    "shopify-app",
    "polaris",
    "polaris-web-components",
    "polaris-2",
    "react",
    "filters",
    "search",
    "index-table",
    "saved-views"
  ],
  "license": "MIT",
  "author": "LJS Studios Ltd",
  "homepage": "https://index-filter-bar.mintlify.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ljsstudios/index-filter-bar.git"
  },
  "bugs": "https://github.com/ljsstudios/index-filter-bar/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./locales/*.json": "./dist/locales/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm knip && pnpm test",
    "build": "vite build && tsc -p tsconfig.build.json",
    "pack:check": "pnpm build && npm pack --dry-run",
    "demo": "vite --config vite.demo.config.ts",
    "demo:build": "vite build --config vite.demo.config.ts",
    "demo:preview": "vite preview --config vite.demo.config.ts",
    "data:fetch": "node scripts/fetch-mock-shop.ts",
    "data:generate": "node scripts/generate-demo-data.ts"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@shopify/polaris-types": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@shopify/polaris-types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@shopify/polaris-types": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.0",
    "knip": "^5.88.1",
    "lint-staged": "^15.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
